# qa.fedal.cl. Lo instala deploy/agente.sh en cada release: editarlo en el servidor no
# sirve, porque el próximo release lo reemplaza. Por lo mismo, no activar "Privacidad de
# directorios" de cPanel sobre esta carpeta: escribe aquí y se perdería. Se prueba en
# deploy/htaccess.test.mjs.

Options -Indexes

# Sin la barra final que mod_dir agrega a una carpeta: /el-club es una página prerenderizada
# (el-club/index.html) y se sirve con esa URL, sin redirigir (T361, SPEC-seo.md A11). Es de la
# misma clase de AllowOverride que ExpiresActive, que este archivo ya usa. Sin listado de
# carpetas (Options -Indexes), apagarla no expone nada.
DirectorySlash Off

# Sin clave desde el 2026-10-09, a pedido del usuario: el cliente prueba QA sin tener que
# escribirla (antes, plan § 0.9). Sigue fuera de los buscadores, porque no es el sitio del
# club, y los correos siguen yendo a la casilla de CORREO_DESVIO.
Header always set X-Robots-Tag "noindex, nofollow"

# index.html nombra los chunks de su release, y el agente borra los del anterior: si el
# navegador lo guardara, pediría archivos que ya no existen. Vale para cada página prerenderizada
# (su carpeta/index.html) y para index.csr.html, el de las rutas del navegador (T361).
<FilesMatch "^index(\.csr)?\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>

# Lo que lleva hash en el nombre no cambia nunca: el release siguiente trae otro nombre. Un año y
# sin volver a preguntar (T367, SPEC-seo.md T8): el JavaScript, el CSS y las fuentes de media/. Las
# fotos y og.jpg no llevan hash, se reemplazan con el mismo nombre, y quedan como estaban.
<FilesMatch "^(main|chunk|polyfills|styles)-[A-Za-z0-9_-]{8}\.(js|css)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<If "%{REQUEST_URI} =~ m#^/media/#">
  Header set Cache-Control "public, max-age=31536000, immutable"
</If>

# La configuración global del servidor les pone caché a las respuestas con mod_expires, y
# ningún .htaccess de la cuenta lo pide (D4): a /api/yo, medido con curl, un mes. /api/yo es
# lo que le dice a la web quién tiene sesión: el navegador guardaba el "nadie" de antes del
# login y, después de entrar, la web seguía mostrando "Entrar". Y a una redirección, como la
# de /api/auth/google, le pone lo mismo: el navegador repetiría un mes la ida a Google con
# un state ya usado. En /api, la caché la decide la API: mod_expires no la toca, y lo que no
# trae Cache-Control propio sale con no-store. Las fotos de torneo traen el suyo (un año).
<If "%{REQUEST_URI} =~ m#^/api/#">
  ExpiresActive Off
</If>
Header set Cache-Control "no-store" "expr=%{REQUEST_URI} =~ m#^/api/# && %{REQUEST_URI} !~ m#^/api/torneos/fotos/#"

# Propio y no heredado: así las reglas del .htaccess de public_html no entran aquí.
RewriteEngine On

# El document root está dentro de public_html, así que QA también respondería en
# fedal.cl/qa.fedal.cl/. Solo se sirve con su nombre.
RewriteCond %{HTTP_HOST} !^qa\.fedal\.cl(:[0-9]+)?$ [NC]
RewriteRule ^ - [F]

# Todo a HTTPS: este servidor no ofrece "Forzar redirección HTTPS" en cPanel. Se exime
# /.well-known/, que AutoSSL puede validar por HTTP.
RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# /api es de Passenger, que lo configura en api/.htaccess (lo escribe el Selector).
RewriteRule ^api(/|$) - [L]

# Las páginas prerenderizadas (T361, SPEC-seo.md A11), con una sola URL: con barra final, 301 a
# la URL sin barra (con la consulta, que Apache agrega sola).
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

# /el-club sirve el-club/index.html tal cual, sin redirigir. La portada es el index.html de la
# raíz.
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# Lo demás que no es un archivo se dibuja en el navegador: index.csr.html, que deja el build
# cuando hay prerender. También una carpeta sin index.html, que así no se lista.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.csr.html [L]
