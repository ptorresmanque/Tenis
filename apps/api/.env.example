# Copiar a .env y ajustar. El .env real nunca se commitea.
#
# Prisma conecta por TCP, así que el usuario de base de datos necesita contraseña.
# Un usuario que autentique solo por unix_socket no sirve.
#
#   CREATE DATABASE tenis_dev    CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE DATABASE tenis_test   CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE DATABASE tenis_shadow CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'tenis'@'127.0.0.1' IDENTIFIED BY '<clave>';
#   GRANT ALL PRIVILEGES ON tenis_dev.*    TO 'tenis'@'127.0.0.1';
#   GRANT ALL PRIVILEGES ON tenis_test.*   TO 'tenis'@'127.0.0.1';
#   GRANT ALL PRIVILEGES ON tenis_shadow.* TO 'tenis'@'127.0.0.1';

DATABASE_URL="mysql://tenis:<clave>@127.0.0.1:3306/tenis_dev"

# Base auxiliar que Prisma usa para validar migraciones. Debe existir y estar vacía:
# el usuario del proyecto no tiene permiso global para crearla al vuelo.
SHADOW_DATABASE_URL="mysql://tenis:<clave>@127.0.0.1:3306/tenis_shadow"

# 3000 suele estar ocupado por otros proyectos. Si cambias esto, actualiza
# también el target de apps/web/proxy.conf.json.
PORT=3001
WEB_ORIGIN="http://localhost:4200"

# Cuántos proxies hay entre internet y la aplicación. En desarrollo, ninguno.
# En producción detrás de nginx, normalmente 1.
#
# **Importa para el freno a la fuerza bruta del login**, que bloquea por correo e IP:
# sin esto, detrás de un proxy todo el mundo comparte la IP del proxy y cualquiera
# puede dejar sin cuenta a un socio quince minutos con cinco intentos fallidos. Y de
# más, confiar en el encabezado cuando no hay proxy deja fingir una IP por intento.
PROXIES_DE_CONFIANZA=0

# Base pública de la API. Va en el enlace de verificación del correo, que se abre
# desde el cliente de correo y no pasa por el proxy de la SPA, así que tiene que ser
# una URL absoluta y alcanzable. Si no está, se asume http://localhost:$PORT/api.
API_PUBLIC_URL="http://localhost:3001/api"

# Credenciales OAuth del proyecto de Google Cloud. Sin ellas la aplicación arranca
# igual y todo funciona salvo el botón de entrar con Google.
# En la consola de Google hay que autorizar como URI de redirección exactamente:
#   $API_PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Pagos. Sin ninguna de estas variables se usa el ambiente de integración de
# Transbank con sus credenciales públicas de prueba, que es lo que corresponde
# mientras el club no tenga afiliación comercial (SPEC-pagos.md § Ambiente).
#
# WEBPAY_AMBIENTE=produccion exige las otras dos y falla al arrancar si faltan: es
# preferible no levantar a levantar cobrando contra el comercio equivocado. Pasar a
# producción además necesita una certificación de Transbank que no se puede simular.
# WEBPAY_AMBIENTE="integracion"
# WEBPAY_CODIGO_COMERCIO=""
# WEBPAY_API_KEY=""

# PAGOS_PASARELA=doble reemplaza Webpay por el falso: autoriza y rechaza a pedido,
# sin salir a internet. Es la salida si el ambiente de integración está caído el día
# de la demo, que es un riesgo que no depende de nosotros.
# PAGOS_PASARELA="doble"
