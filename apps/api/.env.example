# Copiar a .env y ajustar. El .env real nunca se commitea.
#
# Prisma conecta por TCP, así que el usuario de base de datos necesita contraseña.
# Un usuario que autentique solo por unix_socket no sirve.
#
#   CREATE DATABASE tenis_dev    CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE DATABASE tenis_test   CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE DATABASE tenis_shadow CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'tenis'@'127.0.0.1' IDENTIFIED BY '<clave>';
#   GRANT ALL PRIVILEGES ON tenis_dev.*    TO 'tenis'@'127.0.0.1';
#   GRANT ALL PRIVILEGES ON tenis_test.*   TO 'tenis'@'127.0.0.1';
#   GRANT ALL PRIVILEGES ON tenis_shadow.* TO 'tenis'@'127.0.0.1';

DATABASE_URL="mysql://tenis:<clave>@127.0.0.1:3306/tenis_dev"

# Base auxiliar que Prisma usa para validar migraciones. Debe existir y estar vacía:
# el usuario del proyecto no tiene permiso global para crearla al vuelo.
SHADOW_DATABASE_URL="mysql://tenis:<clave>@127.0.0.1:3306/tenis_shadow"

# 3000 suele estar ocupado por otros proyectos. Si cambiás esto, actualizá
# también el target de apps/web/proxy.conf.json.
PORT=3001
WEB_ORIGIN="http://localhost:4200"

# Base pública de la API. Va en el enlace de verificación del correo, que se abre
# desde el cliente de correo y no pasa por el proxy de la SPA, así que tiene que ser
# una URL absoluta y alcanzable. Si no está, se asume http://localhost:$PORT/api.
API_PUBLIC_URL="http://localhost:3001/api"
