// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // NestJS compila a CommonJS. Sin esto el cliente se genera como ESM, usa
  // import.meta y ni Jest ni el build de Nest lo pueden leer.
  moduleFormat        = "cjs"
  importFileExtension = ""
  runtime             = "nodejs"
}

datasource db {
  provider = "mysql"
}

// ── identidad ────────────────────────────────────────────────────────────────
// Modelo de SPEC-identidad.md § Modelo de datos.

/// Toda persona que entra al sistema. Un visitante es un `Usuario` sin `Socio`.
///
/// `esAdmin` es booleano y no un rol: el presidente del club es admin *y* socio,
/// y un enum de tres valores obligaría a inventar ADMIN_SOCIO.
model Usuario {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  nombre   String
  apellido String
  telefono String?

  /// Nulo para quien entra solo con Google: nunca eligió una contraseña.
  passwordHash String? @map("password_hash")
  /// Único: dos usuarios no pueden compartir la misma cuenta de Google (T7).
  googleId     String? @unique @map("google_id")

  emailVerificado Boolean @default(false) @map("email_verificado")
  esAdmin         Boolean @default(false) @map("es_admin")

  /// SHA-256 del token de verificación, nunca el token. Quien lea la base no
  /// puede verificar cuentas ajenas con lo que encuentre acá.
  verificacionTokenHash String?   @unique @map("verificacion_token_hash")
  verificacionExpiraEn  DateTime? @map("verificacion_expira_en")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  socio         Socio?
  profesor      Profesor?
  sesiones      Sesion[]
  transacciones Transaccion[]

  @@map("usuario")
}

/// Sesión abierta en el servidor. La cookie solo lleva el identificador; acá vive
/// su hash, así que un dump de la base no sirve para hacerse pasar por nadie.
///
/// Se guarda en tabla y no en un JWT para poder cerrarla: un token firmado vale
/// hasta que vence y no hay forma de echar a alguien antes.
model Sesion {
  tokenHash String   @id @map("token_hash")
  usuarioId Int      @map("usuario_id")
  creadaEn  DateTime @default(now()) @map("creada_en")
  expiraEn  DateTime @map("expira_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesion")
}

enum EstadoSocio {
  ACTIVO
  SUSPENDIDO
  RETIRADO
}

/// Ficha de socio sobre un `Usuario`. Un usuario tiene a lo sumo una.
model Socio {
  id          Int         @id @default(autoincrement())
  usuarioId   Int         @unique @map("usuario_id")
  numeroSocio String      @unique @map("numero_socio")
  estado      EstadoSocio @default(ACTIVO)

  /// Fechas civiles, no instantes: `@db.Date` evita que un socio quede moroso
  /// unas horas antes o después según la zona en que corra el proceso.
  fechaIngreso DateTime @map("fecha_ingreso") @db.Date

  /// Hasta cuándo tiene la cuota pagada. Vive acá y no en `cuotas` porque
  /// `reservas` lo necesita y se construye antes; ver SPEC-identidad.md.
  /// `cuotas`, cuando exista, será el único que lo escriba.
  alDiaHasta DateTime @map("al_dia_hasta") @db.Date

  /// Hasta cuándo no puede reservar, por una hora que tomó y no usó (T34).
  /// Fecha civil como `alDiaHasta`: una sanción dura días, no horas. Nula es lo
  /// normal —la mayoría de los socios nunca la tiene— y por eso no hay un booleano
  /// aparte que pueda quedar en desacuerdo con la fecha.
  sancionadoHasta DateTime? @map("sancionado_hasta") @db.Date

  usuario         Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  reservas        Reserva[]
  acompanamientos AcompananteReserva[]
  reportes        ReporteNoUso[]
  cuotas          Cuota[]
  clases          InscripcionClase[]
  jugador         Jugador?

  @@map("socio")
}

/// Quién cambió qué en la ficha de un socio, y cuándo (T37).
///
/// Nace de la problemática 2.4 del perfil: el padrón vivía en una planilla donde el
/// estado y la vigencia de la cuota se corregían a mano sin constancia de nada.
///
/// **Un renglón por campo, no una foto de la ficha entera.** Lo que se pregunta seis
/// meses después es "quién le cambió el estado", y una lista de campos se responde
/// leyéndola; una sucesión de fotos hay que compararla de a dos.
///
/// **Sin claves foráneas, a propósito.** Ni a `socio` ni al usuario que hizo el
/// cambio: el historial de decisiones sobrevive a la ficha y a la cuenta, y con una
/// cascada se iría justo cuando alguien pregunta. Por eso el nombre de quien lo hizo
/// va congelado en texto y no se resuelve al leer.
model CambioSocio {
  id      Int @id @default(autoincrement())
  socioId Int @map("socio_id")

  /// "estado", "alDiaHasta", "numeroSocio" o "sancionadoHasta". Solo los cuatro que
  /// cambian lo que el socio puede hacer; el teléfono y el correo no se auditan.
  campo String @db.VarChar(40)

  /// Como se veían, ya formateados. Vacío es "no tenía valor".
  valorAnterior String @map("valor_anterior") @db.VarChar(80)
  valorNuevo    String @map("valor_nuevo") @db.VarChar(80)

  hechoPor       Int      @map("hecho_por")
  hechoPorNombre String   @map("hecho_por_nombre") @db.VarChar(120)
  hechoEn        DateTime @default(now()) @map("hecho_en")

  /// Lo que el admin escribió al hacerlo. Opcional: la sanción por no usar una hora
  /// trae el suyo desde el sistema, y el club a veces no explica una suspensión.
  motivo String? @db.VarChar(200)

  @@index([socioId, hechoEn])
  @@map("cambio_socio")
}

enum TipoSolicitud {
  SOCIO
  CLASES
  EMPRESA
  OTRO
}

enum EstadoSolicitud {
  NUEVA
  ATENDIDA
  DESCARTADA
}

/// Alguien de afuera que le escribió al club (T38).
///
/// Nace de la problemática 2.5 del perfil: no había dónde mandar a un interesado en
/// asociarse, a un apoderado que busca clases ni a una empresa.
///
/// **Es una bandeja y no un buzón de correo.** Podría ser un `mailto:` y ahorrarse
/// esta tabla; no lo es porque el club necesita saber **cuántos interesados llegan y
/// cuántos terminan siendo socios**, que es el único modo de saber si tener sitio
/// sirvió para algo. Un correo no se cuenta, y el que nadie contestó no se distingue
/// del que nunca llegó.
model SolicitudContacto {
  id   Int           @id @default(autoincrement())
  tipo TipoSolicitud

  nombre   String  @db.VarChar(120)
  /// Uno de los dos alcanza, pero no puede faltar ninguno: una solicitud que el club
  /// no puede contestar ocupa la bandeja como si se pudiera.
  email    String  @db.VarChar(160)
  telefono String  @db.VarChar(40)
  mensaje  String? @db.VarChar(1000)

  estado   EstadoSolicitud @default(NUEVA)
  creadaEn DateTime        @default(now()) @map("creada_en")

  atendidaEn  DateTime? @map("atendida_en")
  /// Qué admin la atendió. Sin FK, como el resto del rastro del club: la solicitud
  /// sobrevive a la cuenta de quien la contestó.
  atendidaPor Int?      @map("atendida_por")
  nota        String?   @db.VarChar(500)

  /// La invitación que salió de esta solicitud, si terminó en un alta. **Es el enlace
  /// que permite contar la conversión**: sin él, "llegaron treinta interesados" y
  /// "entraron cuatro socios" son dos números que nadie puede juntar.
  invitacionId Int? @map("invitacion_id")

  @@index([estado, creadaEn])
  @@map("solicitud_contacto")
}

/// El club aceptó a alguien como socio antes de que esa persona tenga cuenta.
///
/// **Tabla propia y no un `Socio` sin usuario.** Hacer `Socio.usuarioId` nullable
/// convertiría en opcional una relación que hoy lee media base de código —el
/// teléfono que la reserva copia de la ficha, entre otros— y el compilador no
/// avisaría de ninguno de esos usos. Una invitación es un papel del club, no una
/// ficha de socio a medias.
///
/// Se guarda `usadaEn` en vez de borrar la fila al usarse: el club puede mirar a
/// quién invitó y cuándo se sumó, que es la única traza de esa decisión.
model InvitacionSocio {
  id Int @id @default(autoincrement())

  /// Normalizado en minúsculas antes de guardar: `Ana@club.cl` y `ana@club.cl`
  /// son la misma persona, y con dos filas la segunda invitación no haría nada.
  email       String @unique
  numeroSocio String @unique @map("numero_socio")

  /// Hasta cuándo cuenta como al día la ficha que se cree con esta invitación.
  /// Fecha civil, como `Socio.alDiaHasta`.
  alDiaHasta DateTime @map("al_dia_hasta") @db.Date

  creadaEn DateTime  @default(now()) @map("creada_en")
  usadaEn  DateTime? @map("usada_en")

  @@map("invitacion_socio")
}

/// Ficha de profesor. Declarada acá porque es una ficha sobre `Usuario`, pero su
/// dueño funcional es `clases`: `identidad` no sabe qué es una clase.
/// Un usuario puede ser socio y profesor a la vez.
///
/// **`usuarioId` es opcional**: el profesor no entra al sistema —`SPEC-clases.md`
/// § Out of scope— y exigirle cuenta obligaría a crear credenciales que nadie usa
/// para poder anotar un teléfono. Si además es socio, se vincula.
///
/// Los campos de acá no viven en `Usuario` porque son del oficio: el nombre visible
/// es el que el club anuncia y puede no ser el de la cuenta, y la tarifa no le
/// importa a nadie que no sea profesor.
model Profesor {
  id            Int     @id @default(autoincrement())
  usuarioId     Int?    @unique @map("usuario_id")
  activo        Boolean @default(true)
  nombreVisible String  @map("nombre_visible")
  telefono      String
  especialidad  String
  /// Lo que el club le paga la hora. Referencia interna: no se publica.
  tarifaHoraClp Int?    @map("tarifa_hora_clp")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  clases  Clase[]

  @@map("profesor")
}

// ── cuotas ───────────────────────────────────────────────────────────────────
// Modelo de SPEC-cuotas.md § Modelo de datos.

enum TipoCuota {
  INCORPORACION
  MENSUAL
}

enum EstadoCuota {
  PENDIENTE
  PAGADA
  ANULADA
}

enum MedioPago {
  WEBPAY
  EFECTIVO
  TRANSFERENCIA
}

/// Lo que un socio le debe al club por un período, y qué se hizo con esa deuda.
///
/// **Los dos cobros del modelo de socios en una sola tabla**: la incorporación que se
/// paga una vez al entrar y la mensualidad. Podrían ser dos; no lo son porque
/// responden a lo mismo —cuánto debe este socio y por qué— y el estado de cuenta las
/// muestra juntas. En dos tablas, cada consulta de deuda es dos consultas y una unión,
/// y la primera que se olvide de la incorporación deja reservar a alguien que no la
/// pagó.
model Cuota {
  id      Int       @id @default(autoincrement())
  socioId Int       @map("socio_id")
  tipo    TipoCuota @default(MENSUAL)

  /// "AAAA-MM". Para la incorporación es el mes del alta, y nunca se repite.
  ///
  /// **El único sobre (socio, tipo, período) es el mecanismo de emisión**, no una
  /// precaución: la cuota del mes se emite cuando alguien la mira, y dos peticiones
  /// simultáneas chocan acá en vez de crear dos filas. Ver SPEC-cuotas.md § La
  /// emisión es perezosa.
  periodo String @db.VarChar(7)

  /// Congelado al emitir, como `Transaccion.montoClp`. Si el club sube la cuota en
  /// septiembre, las de agosto siguen valiendo lo que valían: quien paga tarde no
  /// puede terminar debiendo más de lo que se le cobró.
  montoClp Int @map("monto_clp")

  /// En pesos y no en porcentaje: el club piensa en pesos —"a la señora Ana le
  /// cobramos 15.000"— y un porcentaje obliga a redondear, que en dinero significa
  /// que la suma del mes no cuadra con el reporte.
  descuentoClp    Int     @default(0) @map("descuento_clp")
  /// Obligatorio cuando hay descuento, y lo impone el servidor: un descuento sin
  /// motivo no se distingue de un error de tipeo seis meses después.
  motivoDescuento String? @map("motivo_descuento") @db.VarChar(200)

  estado    EstadoCuota @default(PENDIENTE)
  emitidaEn DateTime    @default(now()) @map("emitida_en")

  pagadaEn      DateTime?  @map("pagada_en")
  medio         MedioPago?
  /// El cobro en línea, si lo hubo. Sin FK, como `Transaccion.conceptoId`.
  transaccionId Int?       @map("transaccion_id")
  /// Qué admin registró el pago en el mesón. Es dinero que pasó por las manos de una
  /// persona, y sin esto no hay forma de reconstruir una caja que no cuadra.
  registradaPor Int?       @map("registrada_por")

  anuladaPor      Int?    @map("anulada_por")
  motivoAnulacion String? @map("motivo_anulacion") @db.VarChar(200)

  socio Socio @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@unique([socioId, tipo, periodo])
  @@index([periodo, estado])
  @@map("cuota")
}

// ── catalogo-canchas ─────────────────────────────────────────────────────────
// Modelo de SPEC-catalogo-canchas.md § Modelo de datos.
//
// Los bloques horarios no están acá: se calculan a partir de apertura, duración y
// bloqueos (T10). Se guarda lo que alguien decidió, no lo que se deriva.
//
// Las horas locales del club van como texto "HH:MM" y no como TIME: es lo que el
// admin escribe, sobrevive a un cierre a las "24:00", y leer un TIME desde JS
// devuelve un Date con fecha inventada que invita justo al bug de zona que T10
// tiene que evitar.

enum Superficie {
  ARCILLA
  CEMENTO
  PASTO_SINTETICO
}

model Cancha {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  superficie  Superficie
  techada     Boolean    @default(false)
  iluminacion Boolean    @default(false)

  /// Desactivar en vez de borrar: una cancha con historial de reservas no se
  /// puede eliminar sin dejar huérfano ese historial.
  activa Boolean @default(true)
  /// Orden del listado. Las canchas del club tienen un orden que no es el alfabético.
  orden  Int     @default(0)

  horarios HorarioApertura[]
  franjas  FranjaHoraria[]
  bloqueos Bloqueo[]
  reservas Reserva[]
  clases   Clase[]

  @@map("cancha")
}

/// A qué hora abre y cierra una cancha cada día. `canchaId` nulo aplica a todas:
/// el club normalmente abre igual en todas y no hay por qué repetir siete filas
/// por cancha.
model HorarioApertura {
  id        Int  @id @default(autoincrement())
  canchaId  Int? @map("cancha_id")
  /// 0 = domingo .. 6 = sábado, igual que `Date#getUTCDay`.
  diaSemana Int  @map("dia_semana")

  /// Hora local del club, "HH:MM". La conversión a UTC vive en T10.
  horaApertura String @map("hora_apertura") @db.VarChar(5)
  horaCierre   String @map("hora_cierre") @db.VarChar(5)

  cancha Cancha? @relation(fields: [canchaId], references: [id], onDelete: Cascade)

  // Índice y no único: en MySQL dos filas con `cancha_id` NULL no chocan entre sí,
  // así que un UNIQUE acá solo protegería el caso por cancha y daría la falsa
  // impresión de cubrir el general. Que no haya dos aperturas del mismo día lo
  // valida el panel de admin (T13).
  @@index([canchaId, diaSemana])
  @@map("horario_apertura")
}

/// Ventana de tiempo con precio y condición de pico.
///
/// `esPico` y `montoClp` viven en la misma fila a propósito: son la misma ventana
/// mirada desde `reservas` (cupo del socio) y desde `pagos` (tarifa del no-socio).
/// En dos tablas, el admin define el mismo rango dos veces y el primer desajuste
/// produce un socio al que se le descuenta cupo pico en una hora que se cobra valle.
model FranjaHoraria {
  id        Int  @id @default(autoincrement())
  canchaId  Int? @map("cancha_id")
  /// Nulo = todos los días.
  diaSemana Int? @map("dia_semana")

  horaDesde String @map("hora_desde") @db.VarChar(5)
  horaHasta String @map("hora_hasta") @db.VarChar(5)

  esPico   Boolean @default(false) @map("es_pico")
  montoClp Int     @map("monto_clp")

  /// Vigencia como fechas civiles: una tarifa nueva empieza un día, no a una hora.
  /// Cambiar el monto crea una franja nueva y cierra la anterior, así el precio de
  /// una reserva ya pagada no se mueve.
  vigenteDesde DateTime  @map("vigente_desde") @db.Date
  vigenteHasta DateTime? @map("vigente_hasta") @db.Date

  cancha Cancha? @relation(fields: [canchaId], references: [id], onDelete: Cascade)

  @@index([canchaId, diaSemana])
  @@map("franja_horaria")
}

enum MotivoBloqueo {
  MANTENCION
  TORNEO
  CLASE
  OTRO
}

/// Rango en que una cancha no está disponible. Instantes en UTC, a diferencia de
/// la apertura: un bloqueo es un momento concreto, no una regla semanal.
model Bloqueo {
  id       Int @id @default(autoincrement())
  canchaId Int @map("cancha_id")

  inicio DateTime
  fin    DateTime

  motivo      MotivoBloqueo
  descripcion String?

  creadoEn DateTime @default(now()) @map("creado_en")

  cancha Cancha @relation(fields: [canchaId], references: [id], onDelete: Cascade)
  clase  Clase?

  @@index([canchaId, inicio])
  @@map("bloqueo")
}

/// Las reglas configurables del club, en una sola fila con columnas con nombre.
///
/// Un almacén clave-valor genérico sería más código que estas seis columnas y
/// perdería el chequeo de tipos. Cuando aparezca la séptima regla, se agrega una
/// columna. Ver SPEC.md § Configuración.
///
/// La fila es única y lo impone la base: un CHECK (id = 1) en la migración. Sin él,
/// una segunda fila hace que "la configuración del club" dependa de cuál lea cada
/// consulta, y eso no se nota hasta que dos pantallas muestran precios distintos.
model ConfiguracionClub {
  id Int @id @default(1)

  /// Los datos del club, para que dejen de estar escritos en las plantillas.
  ///
  /// Viven acá y no en variables de entorno porque los cambia el club desde su
  /// panel, no quien despliega: mudarse de local no puede exigir un redeploy. El
  /// logotipo **no** está: es un archivo, necesita dónde guardarse, y eso es una
  /// decisión de infraestructura que este módulo no alcanza.
  nombre    String @default("FEDAL Tennis Center") @db.VarChar(120)
  direccion String @default("") @db.VarChar(200)
  telefono  String @default("") @db.VarChar(40)
  email     String @default("") @db.VarChar(120)

  duracionBloqueMin    Int @default(60) @map("duracion_bloque_min")
  cupoDiarioSocioHoras Int @default(1) @map("cupo_diario_socio_horas")
  cupoPicoSemanalHoras Int @default(2) @map("cupo_pico_semanal_horas")
  invitadosPorMes      Int @default(4) @map("invitados_por_mes")
  horasMinModificacion Int @default(6) @map("horas_min_modificacion")
  horasReembolsoTotal  Int @default(24) @map("horas_reembolso_total")
  /// Cuántos días queda sin reservar el socio que tomó una hora y no la usó (T34).
  diasSancionNoUso     Int @default(15) @map("dias_sancion_no_uso")

  /// Lo que vale la mensualidad hoy. Una columna con nombre, como las otras siete: el
  /// monto histórico no se pierde porque **cada cuota lo congela**, que es justo lo
  /// que una tabla de precios con vigencia vendría a resolver.
  cuotaMensualClp Int @default(25000) @map("cuota_mensual_clp")

  /// La inscripción por única vez, el otro cobro del modelo de socios.
  cuotaIncorporacionClp Int @default(150000) @map("cuota_incorporacion_clp")

  /// Desde qué fecha de ingreso se cobra la incorporación (T42).
  ///
  /// **El club arranca con su padrón, y esa gente la pagó hace años fuera del
  /// sistema.** Sin este corte habría que acordarse de marcar una por una las de los
  /// socios migrados, y la que se olvide deja a alguien sin poder reservar por una
  /// deuda que no tiene.
  ///
  /// Por defecto es el día en que se aplica la migración, que es exactamente la
  /// puesta en marcha. Fecha civil, como `alDiaHasta`.
  cobraIncorporacionDesde DateTime @default(now()) @map("cobra_incorporacion_desde") @db.Date

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion_club")
}

// ── pagos ────────────────────────────────────────────────────────────────────
// Modelo de SPEC-pagos.md § Modelo de datos.

enum ConceptoPago {
  RESERVA
  CUOTA
}

enum EstadoTransaccion {
  PENDIENTE
  AUTORIZADA
  RECHAZADA
  ANULADA
  EXPIRADA
}

/// Un cobro y su resultado. `pagos` no sabe qué se está pagando: recibe un monto y
/// una referencia opaca, y `reservas` o `cuotas` interpretan `conceptoId`.
///
/// Las transiciones de estado las impone `src/pagos/estados.ts`, no la base: MySQL
/// no tiene triggers que valgan la pena mantener acá y el enum solo dice qué valores
/// existen, no en qué orden se pueden recorrer.
model Transaccion {
  id Int @id @default(autoincrement())

  /// Identificador que viaja a la pasarela. Único: es lo que evita que un reintento
  /// del cliente inicie dos cobros del mismo concepto.
  referencia String @unique

  concepto   ConceptoPago
  /// Id de la reserva o de la cuota. Sin FK a propósito: apunta a dos tablas
  /// distintas según `concepto`, y `pagos` no depende de ninguna de las dos.
  conceptoId Int          @map("concepto_id")

  /// Nulo: el no-socio paga sin cuenta.
  usuarioId Int? @map("usuario_id")

  /// Inicio del bloque que se compró, conservado aunque la reserva se reagende.
  /// Sin esto, quien quiere cancelar faltando 12 horas mueve la reserva a la semana
  /// siguiente y después cancela con 24 horas de sobra, cobrando un reembolso que no
  /// le correspondía. La ventana se mide contra este instante (T24).
  inicioBloqueOriginal DateTime? @map("inicio_bloque_original")

  /// Entero: el peso chileno no tiene centavos y un flotante acá es un monto que la
  /// pasarela redondea y que después no cuadra con el guardado. Lo calcula el
  /// servidor con `franjaPara()`; nunca llega del cliente.
  montoClp Int               @map("monto_clp")
  estado   EstadoTransaccion @default(PENDIENTE)

  pasarela      String
  /// Único y nulable: nace sin token y en MySQL dos NULL no chocan, así que el club
  /// puede tener varios pagos iniciados. Cuando llega, el único es lo que hace que
  /// dos callbacks concurrentes de la pasarela produzcan un solo efecto (T18).
  tokenPasarela String? @unique @map("token_pasarela")

  codigoAutorizacion String? @map("codigo_autorizacion")
  /// Lo único que se guarda de la tarjeta. Nunca el número.
  ultimosDigitos     String? @map("ultimos_digitos") @db.VarChar(4)

  /// Algo no cuadra y lo tiene que mirar una persona: la pasarela reportó un monto
  /// distinto al guardado, o el cobro llegó después de que la transacción expirara.
  /// Una marca en la base y no un log, porque alguien tiene que poder encontrarla
  /// mañana. No está en `SPEC-pagos.md` § Modelo de datos; lo exige el criterio de
  /// T18 de "queda marcada para revisión manual", que sin columna no es verificable.
  requiereRevision Boolean @default(false) @map("requiere_revision")

  creadaEn     DateTime  @default(now()) @map("creada_en")
  confirmadaEn DateTime? @map("confirmada_en")

  // El pago sobrevive a la baja del usuario: es el registro de que el club cobró.
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@map("transaccion")
}

// ── reservas ─────────────────────────────────────────────────────────────────
// Modelo de SPEC-reservas.md § Modelo de datos.

enum EstadoReserva {
  PENDIENTE_PAGO
  CONFIRMADA
  CANCELADA
  EXPIRADA
}

/// Quién ocupa qué cancha y cuándo.
///
/// **La unicidad del bloque la impone la base, no el código** (T2). El índice único
/// no va sobre `(cancha_id, inicio)` a secas: una cancelada tiene que liberar la hora
/// y su fila sigue ahí para el historial. Va sobre `inicio_activo`, una columna
/// generada que vale `inicio` mientras la reserva ocupa el bloque y NULL cuando no —
/// en MySQL dos NULL no chocan, así que conviven todas las canceladas y a lo sumo una
/// activa. Está escrita a mano en la migración, como el CHECK de `ConfiguracionClub`:
/// Prisma no modela columnas generadas, y que la derive la base es justamente el
/// punto. Una columna que el código tiene que acordarse de anular al cancelar es una
/// que alguien va a olvidar, y el síntoma sería un bloque que no vuelve a estar libre.
model Reserva {
  id Int @id @default(autoincrement())

  /// Lo que la persona muestra en el mesón. Único y corto.
  folio String @unique

  /// La llave de la página pública de la reserva, la que abre el QR.
  ///
  /// **No es el folio y no puede serlo.** El folio son 32^7 combinaciones y se dicta
  /// por teléfono; con él en la URL, cualquiera recorre los valores posibles y lee el
  /// nombre y la hora de socios ajenos. Un UUID v4 son 122 bits aleatorios: no se
  /// adivina, no se dicta y no aparece en ninguna pantalla salvo dentro del enlace.
  ///
  /// Lo genera Prisma y no la aplicación, a propósito: por `reserva.create` pasan la
  /// reserva del socio, la del no-socio, las de los tests y las que sembramos, y un
  /// token que dependa de que cada camino se acuerde de pedirlo es un token que
  /// alguna reserva no va a tener.
  token String @unique @default(uuid(4)) @db.VarChar(43)

  canchaId Int      @map("cancha_id")
  inicio   DateTime
  fin      DateTime

  estado EstadoReserva

  /// Congelado al reservar, no recalculado. Si el admin cambia las franjas el jueves,
  /// las horas del lunes no pueden cambiar de categoría y dejar a un socio pasado de
  /// cupo sin que haya hecho nada. Mismo criterio que el monto de `Transaccion`.
  esPico Boolean @default(false) @map("es_pico")

  /// Nulo = no-socio. Su pago vive en `Transaccion` con `concepto: RESERVA` y
  /// `conceptoId` = este id; no se guarda el vínculo inverso para que no haya dos
  /// fuentes que puedan discrepar.
  socioId Int? @map("socio_id")

  /// Del no-socio se piden; del socio se copian de su ficha, para que el panel del
  /// admin muestre a quién llamar sin salir de la tabla.
  nombre   String
  email    String
  telefono String

  creadaEn    DateTime  @default(now()) @map("creada_en")
  canceladaEn DateTime? @map("cancelada_en")

  /// Qué cierre de cancha se llevó esta hora (T36). Nulo es lo normal: casi ninguna
  /// reserva se cancela por un bloqueo.
  ///
  /// **Sin clave foránea, a propósito**, como `Transaccion.conceptoId`: el club borra
  /// el bloqueo cuando la mantención termina, y con `SetNull` se perdería justo el
  /// dato por el que alguien va a preguntar —por qué perdí mi hora— la semana
  /// siguiente. Los ids son autoincrement y no se reutilizan.
  canceladaPorBloqueoId Int? @map("cancelada_por_bloqueo_id")

  /// **La escribe la base, nunca la aplicación.** Es una columna generada —
  /// `IF(estado IN (PENDIENTE_PAGO, CONFIRMADA), inicio, NULL)`, ver la migración— y
  /// MySQL rechaza cualquier INSERT o UPDATE que le mande un valor. Se declara acá
  /// solo para que el índice único de abajo exista en el schema y el guardia de
  /// migraciones no la vea como un cambio sin migrar.
  inicioActivo DateTime? @map("inicio_activo")

  cancha       Cancha               @relation(fields: [canchaId], references: [id], onDelete: Cascade)
  socio        Socio?               @relation(fields: [socioId], references: [id], onDelete: SetNull)
  acompanantes AcompananteReserva[]
  reportes     ReporteNoUso[]

  /// Un bloque, una reserva activa. Las canceladas y expiradas tienen
  /// `inicio_activo` nulo y en MySQL dos nulos no chocan, así que conviven todas.
  @@unique([canchaId, inicioActivo], map: "reserva_bloque_activo")
  @@index([canchaId, inicio])
  @@index([socioId, inicio])
  /// El panel del admin pide el día entero, de todas las canchas: filtra por `inicio`
  /// sin `cancha_id`, así que los dos índices de arriba no le sirven —MySQL solo usa
  /// un índice compuesto desde su primera columna— y recorría la tabla completa. Lo
  /// hace en cada carga y en cada aviso en vivo.
  @@index([inicio])
  @@map("reserva")
}

enum EstadoReporte {
  PENDIENTE
  SANCIONADO
  DESCARTADO
}

/// Alguien vio esa cancha vacía a la hora que estaba reservada.
///
/// **Anónimo hacia afuera, no hacia la base.** `reportanteSocioId` se guarda —es lo
/// único que impide que una persona reporte cinco veces la misma hora y simule un
/// consenso— y no sale por ninguna respuesta de la API, tampoco por la del admin.
/// El anonimato es una propiedad del endpoint, y por eso tiene test propio: un
/// `select` de más lo rompería en silencio.
///
/// **La sanción la aplica el admin, nunca el sistema.** Un castigo automático
/// convierte esto en un arma: dos socios molestos dejan a un tercero sin reservar
/// quince días y nadie revisó nada. Ver SPEC-reservas.md § Hora reservada y no usada.
model ReporteNoUso {
  id Int @id @default(autoincrement())

  reservaId         Int @map("reserva_id")
  reportanteSocioId Int @map("reportante_socio_id")

  estado   EstadoReporte @default(PENDIENTE)
  creadoEn DateTime      @default(now()) @map("creado_en")

  resueltoEn           DateTime? @map("resuelto_en")
  /// Qué admin lo resolvió. Sin FK: si esa cuenta se borra, el reporte sigue
  /// contando lo que pasó, que es para lo que existe.
  resueltoPorUsuarioId Int?      @map("resuelto_por_usuario_id")

  reserva    Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  reportante Socio   @relation(fields: [reportanteSocioId], references: [id], onDelete: Cascade)

  /// Un reporte por persona y por reserva. Lo impone la base: sin esto, quien
  /// quiera hundir a otro socio aprieta el botón diez veces y la bandeja del admin
  /// muestra diez reportes de una sola persona.
  @@unique([reservaId, reportanteSocioId])
  @@index([estado])
  @@map("reporte_no_uso")
}

/// Con quién juega el socio. Obligatorio declararlo: sin eso, "juego solo", "juego
/// con un socio" y "traje a un amigo" se ven idénticos, y el cupo de invitados no
/// controla nada.
///
/// Los dos tipos en la misma tabla porque son la respuesta a la misma pregunta.
/// `socioId` = socio del club, que no gasta cupo de nadie; `nombre` = invitado
/// externo, que cuenta contra los 4 del mes. Exactamente uno de los dos.
model AcompananteReserva {
  id        Int  @id @default(autoincrement())
  reservaId Int  @map("reserva_id")
  socioId   Int? @map("socio_id")

  /// Solo un nombre: el invitado no tiene ficha propia (pregunta abierta 13). Muere
  /// con la reserva y no se reutiliza.
  nombre String?

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  socio   Socio?  @relation(fields: [socioId], references: [id], onDelete: SetNull)

  @@index([reservaId])
  @@index([socioId])
  @@map("acompanante_reserva")
}

// ── clases ───────────────────────────────────────────────────────────────────
// Modelo de SPEC-clases.md § Modelo de datos.

enum NivelClase {
  INICIACION
  INTERMEDIO
  COMPETITIVO
  NINOS
}

enum EstadoClase {
  PROGRAMADA
  REALIZADA
  CANCELADA
}

/// Una clase con profesor: cuándo es, quién la da y en qué cancha.
///
/// **`bloqueoId` es la razón de ser del módulo.** La clase y el `Bloqueo` que cierra
/// la cancha se crean en la misma transacción: sin eso queda o una clase con la
/// cancha abierta —a la que alguien reserva encima— o un bloqueo huérfano que nadie
/// sabe por qué está ahí. Ver `SPEC-clases.md` § Agendar crea el bloqueo.
///
/// Es opcional porque cancelar la clase **borra** su bloqueo para devolver la hora a
/// la disponibilidad; la clase queda con su historia y sin bloqueo.
model Clase {
  id         Int @id @default(autoincrement())
  profesorId Int @map("profesor_id")
  canchaId   Int @map("cancha_id")

  /// Instantes en UTC, como el bloqueo: una clase es un momento concreto.
  inicio DateTime
  fin    DateTime

  cupoMaximo Int         @map("cupo_maximo")
  nivel      NivelClase
  estado     EstadoClase @default(PROGRAMADA)

  bloqueoId Int?    @unique @map("bloqueo_id")
  notas     String?

  canceladaEn       DateTime? @map("cancelada_en")
  motivoCancelacion String?   @map("motivo_cancelacion")

  creadaEn DateTime @default(now()) @map("creada_en")

  profesor      Profesor           @relation(fields: [profesorId], references: [id])
  cancha        Cancha             @relation(fields: [canchaId], references: [id], onDelete: Cascade)
  bloqueo       Bloqueo?           @relation(fields: [bloqueoId], references: [id], onDelete: SetNull)
  inscripciones InscripcionClase[]

  @@index([inicio])
  @@index([canchaId, inicio])
  @@map("clase")
}

enum EstadoInscripcion {
  INSCRITA
  CANCELADA
  ASISTIO
  FALTO
}

/// Quién viene a una clase: un socio del club o un alumno de afuera.
///
/// **Los dos tipos en la misma tabla**, por la misma razón que `AcompananteReserva`:
/// son la respuesta a la misma pregunta —quién viene a esta clase— y el club tiene
/// que poder mirar una clase y ver la lista completa. En dos tablas, contar el cupo
/// exige sumar dos consultas y es cuestión de tiempo que una se olvide.
///
/// **Exactamente uno de los dos.** La mitad que toca `socioId` la impone
/// `Inscripciones` y no la base: MariaDB no deja que una columna con foreign key
/// participe en un CHECK, el mismo muro de `AcompananteReserva`. La otra mitad —el
/// alumno de afuera no queda sin teléfono— sí va en un CHECK, ver la migración.
///
/// **El alumno de afuera deja teléfono**, a diferencia del invitado de una reserva:
/// a aquel lo trae un socio que responde por él; a este lo tiene que poder llamar el
/// club cuando el profesor se enferma.
model InscripcionClase {
  id      Int @id @default(autoincrement())
  claseId Int @map("clase_id")

  /// Socio del club. Nulo = alumno de afuera.
  socioId Int? @map("socio_id")

  /// Del alumno de afuera. Nulos cuando la inscripción es de un socio: su nombre y su
  /// teléfono se leen de su ficha y siguen al día si los cambió.
  nombre   String? @db.VarChar(120)
  telefono String? @db.VarChar(40)

  estado     EstadoInscripcion @default(INSCRITA)
  inscritaEn DateTime          @default(now()) @map("inscrita_en")

  /// **La escribe la base, nunca la aplicación.** Columna generada —
  /// `IF(estado = 'CANCELADA', NULL, socio_id)`, ver la migración— con el mismo
  /// truco que `inicio_activo` en `Reserva`: el único no puede ir sobre
  /// `(clase_id, socio_id)` a secas porque un socio que canceló tiene que poder
  /// volver a inscribirse, y su fila sigue ahí para el historial.
  socioActivo Int? @map("socio_activo")

  clase Clase  @relation(fields: [claseId], references: [id], onDelete: Cascade)
  socio Socio? @relation(fields: [socioId], references: [id], onDelete: SetNull)

  /// Un socio, una inscripción viva por clase. Las canceladas tienen `socio_activo`
  /// nulo y en MySQL dos nulos no chocan; el alumno de afuera lo tiene siempre nulo,
  /// así que dos homónimos conviven —son dos personas distintas—.
  @@unique([claseId, socioActivo], map: "inscripcion_socio_activo")
  @@index([claseId])
  @@index([socioId])
  @@map("inscripcion_clase")
}

// ── torneos ──────────────────────────────────────────────────────────────────
// Modelo de SPEC-torneos.md § Modelo de datos.

/// Quien juega torneos. **No es el socio, y esa es la decisión que da forma al módulo.**
///
/// Va en contra de lo que hizo `reservas` con el invitado —un nombre suelto que muere
/// con la reserva— y el contraste es el argumento: aquel no tiene identidad que
/// reutilizar, este sí. Vuelve el año siguiente, acumula puntos y aparece en una tabla
/// que ordena personas; sin ficha estable, el ranking suma "J. Pérez" y "Juan Pérez"
/// por separado y la tabla queda mal a la vista de todos.
///
/// `socioId` único y opcional: nulo es un jugador de afuera, y un socio tiene a lo
/// sumo un jugador. Enlazar un externo a una ficha de socio es escribir este campo, y
/// por eso **sus puntos viajan con él**: cuelgan del jugador, no del socio.
model Jugador {
  id       Int     @id @default(autoincrement())
  socioId  Int?    @unique @map("socio_id")
  nombre   String  @db.VarChar(80)
  apellido String  @db.VarChar(80)
  telefono String? @db.VarChar(40)
  activo   Boolean @default(true)

  creadoEn DateTime @default(now()) @map("creado_en")

  socio           Socio?              @relation(fields: [socioId], references: [id], onDelete: SetNull)
  inscripciones   InscripcionTorneo[]
  partidosComoA   Partido[]           @relation("PartidosComoA")
  partidosComoB   Partido[]           @relation("PartidosComoB")
  partidosGanados Partido[]           @relation("PartidosGanados")

  @@index([apellido, nombre])
  @@map("jugador")
}

/// Las categorías que el club inventa: "Club 250", "Club 500", "Máster de fin de año".
///
/// **Tabla y no enum**, por la misma razón que las franjas horarias son filas: este año
/// hay una categoría que el año pasado no existía, y agregar un valor a un enum es una
/// migración. De `puntosCampeon` salen los de cada ronda; ver `SPEC-ranking.md`.
model CategoriaTorneo {
  id            Int     @id @default(autoincrement())
  nombre        String  @unique @db.VarChar(80)
  puntosCampeon Int     @map("puntos_campeon")
  activa        Boolean @default(true)

  torneos Torneo[]

  @@map("categoria_torneo")
}

enum EstadoTorneo {
  INSCRIPCION
  CUADRO_ARMADO
  EN_CURSO
  FINALIZADO
  CANCELADO
}

/// Un torneo del club.
model Torneo {
  id          Int    @id @default(autoincrement())
  nombre      String @db.VarChar(120)
  categoriaId Int    @map("categoria_id")

  /// Informativa: en qué se juega. Nula si el club todavía no lo decidió o se juega
  /// en varias.
  superficie Superficie?

  /// Fechas civiles del club, como `alDiaHasta`: un torneo dura días, no horas.
  fechaInicio       DateTime @map("fecha_inicio") @db.Date
  fechaFin          DateTime @map("fecha_fin") @db.Date
  cierreInscripcion DateTime @map("cierre_inscripcion") @db.Date

  /// Cuántos jugadores entran al cuadro. Los que se pasan van a lista de espera.
  cupo   Int
  estado EstadoTorneo @default(INSCRIPCION)

  creadoEn DateTime @default(now()) @map("creado_en")

  /// Con qué semilla se sorteó el cuadro. Se guarda para poder **reproducir** el
  /// sorteo: si alguien pregunta por qué le tocó ese cruce, la respuesta no puede ser
  /// "salió así".
  semillaSorteo Int? @map("semilla_sorteo")

  categoria     CategoriaTorneo     @relation(fields: [categoriaId], references: [id])
  inscripciones InscripcionTorneo[]
  partidos      Partido[]

  @@index([estado, fechaInicio])
  @@map("torneo")
}

enum EstadoInscripcionTorneo {
  INSCRITA
  LISTA_ESPERA
  RETIRADA
}

/// Quién juega un torneo.
///
/// **Pasado el cupo se entra en lista de espera, no se rechaza.** El club llama por
/// teléfono antes de meter a alguien en un cuadro, así que promover es una decisión
/// suya y no un automatismo: ver `SPEC-torneos.md` § Inscripción.
model InscripcionTorneo {
  id        Int @id @default(autoincrement())
  torneoId  Int @map("torneo_id")
  jugadorId Int @map("jugador_id")

  /// 1..n; nulo = sin sembrar. La asigna el admin al armar el cuadro (T51), no el
  /// ranking: es lo que le permite separar a dos que ya jugaron la final el mes pasado.
  siembra Int?

  estado     EstadoInscripcionTorneo @default(INSCRITA)
  inscritaEn DateTime                @default(now()) @map("inscrita_en")

  /// **La escribe la base, nunca la aplicación.** Columna generada —
  /// `IF(estado = 'RETIRADA', NULL, jugador_id)`— con el mismo truco que
  /// `inicio_activo` en `Reserva` y `socio_activo` en `InscripcionClase`: el único no
  /// puede ir sobre `(torneo_id, jugador_id)` a secas porque quien se retira por una
  /// lesión y se recupera antes del cierre tiene que poder volver, y su fila se queda
  /// para que el club vea que se bajó.
  jugadorActivo Int? @map("jugador_activo")

  torneo  Torneo  @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  jugador Jugador @relation(fields: [jugadorId], references: [id])

  @@unique([torneoId, jugadorActivo], map: "inscripcion_jugador_activo")
  @@index([torneoId, estado])
  @@map("inscripcion_torneo")
}

/// Un partido del cuadro.
///
/// **El cuadro se genera completo**, con todos los partidos de todas las rondas y los
/// jugadores nulos donde todavía no se sabe quién llega. Así se puede dibujar entero
/// desde el primer día, que es lo que la gente mira en el mural del club.
///
/// **`ronda` es un número y no un nombre.** "Cuartos de final" depende del tamaño del
/// cuadro: en uno de 8 la ronda 1 es cuartos, en uno de 32 es dieciseisavos. El nombre
/// se calcula al mostrar, contando desde la final hacia atrás.
model Partido {
  id       Int @id @default(autoincrement())
  torneoId Int @map("torneo_id")

  /// 1 = primera ronda. La final es la más alta.
  ronda    Int
  /// Lugar del partido dentro de su ronda, desde arriba del cuadro.
  posicion Int

  /// Nulos hasta que la ronda anterior resuelve. En primera ronda, un nulo es un bye.
  jugadorAId Int? @map("jugador_a_id")
  jugadorBId Int? @map("jugador_b_id")

  ganadorId Int? @map("ganador_id")

  /// Como lo escribe el admin: "6-4 3-6 7-5". **Texto libre a propósito**: el ranking
  /// solo mira quién ganó, y un modelo de sets y tie-breaks es mucho código para un
  /// dato que nadie consulta. Si algún día hacen falta estadísticas, el texto está.
  marcador String? @db.VarChar(60)

  /// El rival no se presentó. Distinto de un bye, que es un lugar vacío del cuadro.
  walkover Boolean @default(false)

  jugadoEn DateTime? @map("jugado_en")

  torneo   Torneo   @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  jugadorA Jugador? @relation("PartidosComoA", fields: [jugadorAId], references: [id])
  jugadorB Jugador? @relation("PartidosComoB", fields: [jugadorBId], references: [id])
  ganador  Jugador? @relation("PartidosGanados", fields: [ganadorId], references: [id])

  @@unique([torneoId, ronda, posicion])
  @@index([torneoId])
  @@map("partido")
}
