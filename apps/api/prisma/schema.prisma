// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // NestJS compila a CommonJS. Sin esto el cliente se genera como ESM, usa
  // import.meta y ni Jest ni el build de Nest lo pueden leer.
  moduleFormat        = "cjs"
  importFileExtension = ""
  runtime             = "nodejs"
}

datasource db {
  provider = "mysql"
}

// ── identidad ────────────────────────────────────────────────────────────────
// Modelo de SPEC-identidad.md § Modelo de datos.

/// Toda persona que entra al sistema. Un visitante es un `Usuario` sin `Socio`.
///
/// `esAdmin` es booleano y no un rol: el presidente del club es admin *y* socio,
/// y un enum de tres valores obligaría a inventar ADMIN_SOCIO.
model Usuario {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  nombre   String
  apellido String
  telefono String?

  /// Nulo para quien entra solo con Google: nunca eligió una contraseña.
  passwordHash String? @map("password_hash")
  /// Único: dos usuarios no pueden compartir la misma cuenta de Google (T7).
  googleId     String? @unique @map("google_id")

  emailVerificado Boolean @default(false) @map("email_verificado")
  esAdmin         Boolean @default(false) @map("es_admin")

  /// SHA-256 del token de verificación, nunca el token. Quien lea la base no
  /// puede verificar cuentas ajenas con lo que encuentre acá.
  verificacionTokenHash String?   @unique @map("verificacion_token_hash")
  verificacionExpiraEn  DateTime? @map("verificacion_expira_en")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  socio         Socio?
  profesor      Profesor?
  sesiones      Sesion[]
  transacciones Transaccion[]

  @@map("usuario")
}

/// Sesión abierta en el servidor. La cookie solo lleva el identificador; acá vive
/// su hash, así que un dump de la base no sirve para hacerse pasar por nadie.
///
/// Se guarda en tabla y no en un JWT para poder cerrarla: un token firmado vale
/// hasta que vence y no hay forma de echar a alguien antes.
model Sesion {
  tokenHash String   @id @map("token_hash")
  usuarioId Int      @map("usuario_id")
  creadaEn  DateTime @default(now()) @map("creada_en")
  expiraEn  DateTime @map("expira_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesion")
}

enum EstadoSocio {
  ACTIVO
  SUSPENDIDO
  RETIRADO
}

/// Ficha de socio sobre un `Usuario`. Un usuario tiene a lo sumo una.
model Socio {
  id          Int         @id @default(autoincrement())
  usuarioId   Int         @unique @map("usuario_id")
  numeroSocio String      @unique @map("numero_socio")
  estado      EstadoSocio @default(ACTIVO)

  /// Fechas civiles, no instantes: `@db.Date` evita que un socio quede moroso
  /// unas horas antes o después según la zona en que corra el proceso.
  fechaIngreso DateTime @map("fecha_ingreso") @db.Date

  /// Hasta cuándo tiene la cuota pagada. Vive acá y no en `cuotas` porque
  /// `reservas` lo necesita y se construye antes; ver SPEC-identidad.md.
  /// `cuotas`, cuando exista, será el único que lo escriba.
  alDiaHasta DateTime @map("al_dia_hasta") @db.Date

  /// Hasta cuándo no puede reservar, por una hora que tomó y no usó (T34).
  /// Fecha civil como `alDiaHasta`: una sanción dura días, no horas. Nula es lo
  /// normal —la mayoría de los socios nunca la tiene— y por eso no hay un booleano
  /// aparte que pueda quedar en desacuerdo con la fecha.
  sancionadoHasta DateTime? @map("sancionado_hasta") @db.Date

  usuario         Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  reservas        Reserva[]
  acompanamientos AcompananteReserva[]
  reportes        ReporteNoUso[]

  @@map("socio")
}

/// El club aceptó a alguien como socio antes de que esa persona tenga cuenta.
///
/// **Tabla propia y no un `Socio` sin usuario.** Hacer `Socio.usuarioId` nullable
/// convertiría en opcional una relación que hoy lee media base de código —el
/// teléfono que la reserva copia de la ficha, entre otros— y el compilador no
/// avisaría de ninguno de esos usos. Una invitación es un papel del club, no una
/// ficha de socio a medias.
///
/// Se guarda `usadaEn` en vez de borrar la fila al usarse: el club puede mirar a
/// quién invitó y cuándo se sumó, que es la única traza de esa decisión.
model InvitacionSocio {
  id Int @id @default(autoincrement())

  /// Normalizado en minúsculas antes de guardar: `Ana@club.cl` y `ana@club.cl`
  /// son la misma persona, y con dos filas la segunda invitación no haría nada.
  email       String @unique
  numeroSocio String @unique @map("numero_socio")

  /// Hasta cuándo cuenta como al día la ficha que se cree con esta invitación.
  /// Fecha civil, como `Socio.alDiaHasta`.
  alDiaHasta DateTime @map("al_dia_hasta") @db.Date

  creadaEn DateTime  @default(now()) @map("creada_en")
  usadaEn  DateTime? @map("usada_en")

  @@map("invitacion_socio")
}

/// Ficha de profesor. Declarada acá porque es una ficha sobre `Usuario`, pero su
/// dueño funcional es `clases`: `identidad` no sabe qué es una clase.
/// Un usuario puede ser socio y profesor a la vez.
model Profesor {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @unique @map("usuario_id")
  activo    Boolean @default(true)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("profesor")
}

// ── catalogo-canchas ─────────────────────────────────────────────────────────
// Modelo de SPEC-catalogo-canchas.md § Modelo de datos.
//
// Los bloques horarios no están acá: se calculan a partir de apertura, duración y
// bloqueos (T10). Se guarda lo que alguien decidió, no lo que se deriva.
//
// Las horas locales del club van como texto "HH:MM" y no como TIME: es lo que el
// admin escribe, sobrevive a un cierre a las "24:00", y leer un TIME desde JS
// devuelve un Date con fecha inventada que invita justo al bug de zona que T10
// tiene que evitar.

enum Superficie {
  ARCILLA
  CEMENTO
  PASTO_SINTETICO
}

model Cancha {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  superficie  Superficie
  techada     Boolean    @default(false)
  iluminacion Boolean    @default(false)

  /// Desactivar en vez de borrar: una cancha con historial de reservas no se
  /// puede eliminar sin dejar huérfano ese historial.
  activa Boolean @default(true)
  /// Orden del listado. Las canchas del club tienen un orden que no es el alfabético.
  orden  Int     @default(0)

  horarios HorarioApertura[]
  franjas  FranjaHoraria[]
  bloqueos Bloqueo[]
  reservas Reserva[]

  @@map("cancha")
}

/// A qué hora abre y cierra una cancha cada día. `canchaId` nulo aplica a todas:
/// el club normalmente abre igual en todas y no hay por qué repetir siete filas
/// por cancha.
model HorarioApertura {
  id        Int  @id @default(autoincrement())
  canchaId  Int? @map("cancha_id")
  /// 0 = domingo .. 6 = sábado, igual que `Date#getUTCDay`.
  diaSemana Int  @map("dia_semana")

  /// Hora local del club, "HH:MM". La conversión a UTC vive en T10.
  horaApertura String @map("hora_apertura") @db.VarChar(5)
  horaCierre   String @map("hora_cierre") @db.VarChar(5)

  cancha Cancha? @relation(fields: [canchaId], references: [id], onDelete: Cascade)

  // Índice y no único: en MySQL dos filas con `cancha_id` NULL no chocan entre sí,
  // así que un UNIQUE acá solo protegería el caso por cancha y daría la falsa
  // impresión de cubrir el general. Que no haya dos aperturas del mismo día lo
  // valida el panel de admin (T13).
  @@index([canchaId, diaSemana])
  @@map("horario_apertura")
}

/// Ventana de tiempo con precio y condición de pico.
///
/// `esPico` y `montoClp` viven en la misma fila a propósito: son la misma ventana
/// mirada desde `reservas` (cupo del socio) y desde `pagos` (tarifa del no-socio).
/// En dos tablas, el admin define el mismo rango dos veces y el primer desajuste
/// produce un socio al que se le descuenta cupo pico en una hora que se cobra valle.
model FranjaHoraria {
  id        Int  @id @default(autoincrement())
  canchaId  Int? @map("cancha_id")
  /// Nulo = todos los días.
  diaSemana Int? @map("dia_semana")

  horaDesde String @map("hora_desde") @db.VarChar(5)
  horaHasta String @map("hora_hasta") @db.VarChar(5)

  esPico   Boolean @default(false) @map("es_pico")
  montoClp Int     @map("monto_clp")

  /// Vigencia como fechas civiles: una tarifa nueva empieza un día, no a una hora.
  /// Cambiar el monto crea una franja nueva y cierra la anterior, así el precio de
  /// una reserva ya pagada no se mueve.
  vigenteDesde DateTime  @map("vigente_desde") @db.Date
  vigenteHasta DateTime? @map("vigente_hasta") @db.Date

  cancha Cancha? @relation(fields: [canchaId], references: [id], onDelete: Cascade)

  @@index([canchaId, diaSemana])
  @@map("franja_horaria")
}

enum MotivoBloqueo {
  MANTENCION
  TORNEO
  CLASE
  OTRO
}

/// Rango en que una cancha no está disponible. Instantes en UTC, a diferencia de
/// la apertura: un bloqueo es un momento concreto, no una regla semanal.
model Bloqueo {
  id       Int @id @default(autoincrement())
  canchaId Int @map("cancha_id")

  inicio DateTime
  fin    DateTime

  motivo      MotivoBloqueo
  descripcion String?

  creadoEn DateTime @default(now()) @map("creado_en")

  cancha Cancha @relation(fields: [canchaId], references: [id], onDelete: Cascade)

  @@index([canchaId, inicio])
  @@map("bloqueo")
}

/// Las reglas configurables del club, en una sola fila con columnas con nombre.
///
/// Un almacén clave-valor genérico sería más código que estas seis columnas y
/// perdería el chequeo de tipos. Cuando aparezca la séptima regla, se agrega una
/// columna. Ver SPEC.md § Configuración.
///
/// La fila es única y lo impone la base: un CHECK (id = 1) en la migración. Sin él,
/// una segunda fila hace que "la configuración del club" dependa de cuál lea cada
/// consulta, y eso no se nota hasta que dos pantallas muestran precios distintos.
model ConfiguracionClub {
  id Int @id @default(1)

  duracionBloqueMin    Int @default(60) @map("duracion_bloque_min")
  cupoDiarioSocioHoras Int @default(1) @map("cupo_diario_socio_horas")
  cupoPicoSemanalHoras Int @default(2) @map("cupo_pico_semanal_horas")
  invitadosPorMes      Int @default(4) @map("invitados_por_mes")
  horasMinModificacion Int @default(6) @map("horas_min_modificacion")
  horasReembolsoTotal  Int @default(24) @map("horas_reembolso_total")
  /// Cuántos días queda sin reservar el socio que tomó una hora y no la usó (T34).
  diasSancionNoUso     Int @default(15) @map("dias_sancion_no_uso")

  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion_club")
}

// ── pagos ────────────────────────────────────────────────────────────────────
// Modelo de SPEC-pagos.md § Modelo de datos.

enum ConceptoPago {
  RESERVA
  CUOTA
}

enum EstadoTransaccion {
  PENDIENTE
  AUTORIZADA
  RECHAZADA
  ANULADA
  EXPIRADA
}

/// Un cobro y su resultado. `pagos` no sabe qué se está pagando: recibe un monto y
/// una referencia opaca, y `reservas` o `cuotas` interpretan `conceptoId`.
///
/// Las transiciones de estado las impone `src/pagos/estados.ts`, no la base: MySQL
/// no tiene triggers que valgan la pena mantener acá y el enum solo dice qué valores
/// existen, no en qué orden se pueden recorrer.
model Transaccion {
  id Int @id @default(autoincrement())

  /// Identificador que viaja a la pasarela. Único: es lo que evita que un reintento
  /// del cliente inicie dos cobros del mismo concepto.
  referencia String @unique

  concepto   ConceptoPago
  /// Id de la reserva o de la cuota. Sin FK a propósito: apunta a dos tablas
  /// distintas según `concepto`, y `pagos` no depende de ninguna de las dos.
  conceptoId Int          @map("concepto_id")

  /// Nulo: el no-socio paga sin cuenta.
  usuarioId Int? @map("usuario_id")

  /// Inicio del bloque que se compró, conservado aunque la reserva se reagende.
  /// Sin esto, quien quiere cancelar faltando 12 horas mueve la reserva a la semana
  /// siguiente y después cancela con 24 horas de sobra, cobrando un reembolso que no
  /// le correspondía. La ventana se mide contra este instante (T24).
  inicioBloqueOriginal DateTime? @map("inicio_bloque_original")

  /// Entero: el peso chileno no tiene centavos y un flotante acá es un monto que la
  /// pasarela redondea y que después no cuadra con el guardado. Lo calcula el
  /// servidor con `franjaPara()`; nunca llega del cliente.
  montoClp Int               @map("monto_clp")
  estado   EstadoTransaccion @default(PENDIENTE)

  pasarela String
  /// Único y nulable: nace sin token y en MySQL dos NULL no chocan, así que el club
  /// puede tener varios pagos iniciados. Cuando llega, el único es lo que hace que
  /// dos callbacks concurrentes de la pasarela produzcan un solo efecto (T18).
  tokenPasarela String? @unique @map("token_pasarela")

  codigoAutorizacion String? @map("codigo_autorizacion")
  /// Lo único que se guarda de la tarjeta. Nunca el número.
  ultimosDigitos     String? @map("ultimos_digitos") @db.VarChar(4)

  /// Algo no cuadra y lo tiene que mirar una persona: la pasarela reportó un monto
  /// distinto al guardado, o el cobro llegó después de que la transacción expirara.
  /// Una marca en la base y no un log, porque alguien tiene que poder encontrarla
  /// mañana. No está en `SPEC-pagos.md` § Modelo de datos; lo exige el criterio de
  /// T18 de "queda marcada para revisión manual", que sin columna no es verificable.
  requiereRevision Boolean @default(false) @map("requiere_revision")

  creadaEn     DateTime  @default(now()) @map("creada_en")
  confirmadaEn DateTime? @map("confirmada_en")

  // El pago sobrevive a la baja del usuario: es el registro de que el club cobró.
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@map("transaccion")
}

// ── reservas ─────────────────────────────────────────────────────────────────
// Modelo de SPEC-reservas.md § Modelo de datos.

enum EstadoReserva {
  PENDIENTE_PAGO
  CONFIRMADA
  CANCELADA
  EXPIRADA
}

/// Quién ocupa qué cancha y cuándo.
///
/// **La unicidad del bloque la impone la base, no el código** (T2). El índice único
/// no va sobre `(cancha_id, inicio)` a secas: una cancelada tiene que liberar la hora
/// y su fila sigue ahí para el historial. Va sobre `inicio_activo`, una columna
/// generada que vale `inicio` mientras la reserva ocupa el bloque y NULL cuando no —
/// en MySQL dos NULL no chocan, así que conviven todas las canceladas y a lo sumo una
/// activa. Está escrita a mano en la migración, como el CHECK de `ConfiguracionClub`:
/// Prisma no modela columnas generadas, y que la derive la base es justamente el
/// punto. Una columna que el código tiene que acordarse de anular al cancelar es una
/// que alguien va a olvidar, y el síntoma sería un bloque que no vuelve a estar libre.
model Reserva {
  id Int @id @default(autoincrement())

  /// Lo que la persona muestra en el mesón. Único y corto.
  folio String @unique

  canchaId Int      @map("cancha_id")
  inicio   DateTime
  fin      DateTime

  estado EstadoReserva

  /// Congelado al reservar, no recalculado. Si el admin cambia las franjas el jueves,
  /// las horas del lunes no pueden cambiar de categoría y dejar a un socio pasado de
  /// cupo sin que haya hecho nada. Mismo criterio que el monto de `Transaccion`.
  esPico Boolean @default(false) @map("es_pico")

  /// Nulo = no-socio. Su pago vive en `Transaccion` con `concepto: RESERVA` y
  /// `conceptoId` = este id; no se guarda el vínculo inverso para que no haya dos
  /// fuentes que puedan discrepar.
  socioId Int? @map("socio_id")

  /// Del no-socio se piden; del socio se copian de su ficha, para que el panel del
  /// admin muestre a quién llamar sin salir de la tabla.
  nombre   String
  email    String
  telefono String

  creadaEn    DateTime  @default(now()) @map("creada_en")
  canceladaEn DateTime? @map("cancelada_en")

  /// **La escribe la base, nunca la aplicación.** Es una columna generada —
  /// `IF(estado IN (PENDIENTE_PAGO, CONFIRMADA), inicio, NULL)`, ver la migración— y
  /// MySQL rechaza cualquier INSERT o UPDATE que le mande un valor. Se declara acá
  /// solo para que el índice único de abajo exista en el schema y el guardia de
  /// migraciones no la vea como un cambio sin migrar.
  inicioActivo DateTime? @map("inicio_activo")

  cancha       Cancha               @relation(fields: [canchaId], references: [id], onDelete: Cascade)
  socio        Socio?               @relation(fields: [socioId], references: [id], onDelete: SetNull)
  acompanantes AcompananteReserva[]
  reportes     ReporteNoUso[]

  /// Un bloque, una reserva activa. Las canceladas y expiradas tienen
  /// `inicio_activo` nulo y en MySQL dos nulos no chocan, así que conviven todas.
  @@unique([canchaId, inicioActivo], map: "reserva_bloque_activo")
  @@index([canchaId, inicio])
  @@index([socioId, inicio])
  /// El panel del admin pide el día entero, de todas las canchas: filtra por `inicio`
  /// sin `cancha_id`, así que los dos índices de arriba no le sirven —MySQL solo usa
  /// un índice compuesto desde su primera columna— y recorría la tabla completa. Lo
  /// hace en cada carga y en cada aviso en vivo.
  @@index([inicio])
  @@map("reserva")
}

enum EstadoReporte {
  PENDIENTE
  SANCIONADO
  DESCARTADO
}

/// Alguien vio esa cancha vacía a la hora que estaba reservada.
///
/// **Anónimo hacia afuera, no hacia la base.** `reportanteSocioId` se guarda —es lo
/// único que impide que una persona reporte cinco veces la misma hora y simule un
/// consenso— y no sale por ninguna respuesta de la API, tampoco por la del admin.
/// El anonimato es una propiedad del endpoint, y por eso tiene test propio: un
/// `select` de más lo rompería en silencio.
///
/// **La sanción la aplica el admin, nunca el sistema.** Un castigo automático
/// convierte esto en un arma: dos socios molestos dejan a un tercero sin reservar
/// quince días y nadie revisó nada. Ver SPEC-reservas.md § Hora reservada y no usada.
model ReporteNoUso {
  id Int @id @default(autoincrement())

  reservaId          Int @map("reserva_id")
  reportanteSocioId  Int @map("reportante_socio_id")

  estado   EstadoReporte @default(PENDIENTE)
  creadoEn DateTime      @default(now()) @map("creado_en")

  resueltoEn           DateTime? @map("resuelto_en")
  /// Qué admin lo resolvió. Sin FK: si esa cuenta se borra, el reporte sigue
  /// contando lo que pasó, que es para lo que existe.
  resueltoPorUsuarioId Int?      @map("resuelto_por_usuario_id")

  reserva    Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  reportante Socio   @relation(fields: [reportanteSocioId], references: [id], onDelete: Cascade)

  /// Un reporte por persona y por reserva. Lo impone la base: sin esto, quien
  /// quiera hundir a otro socio aprieta el botón diez veces y la bandeja del admin
  /// muestra diez reportes de una sola persona.
  @@unique([reservaId, reportanteSocioId])
  @@index([estado])
  @@map("reporte_no_uso")
}

/// Con quién juega el socio. Obligatorio declararlo: sin eso, "juego solo", "juego
/// con un socio" y "traje a un amigo" se ven idénticos, y el cupo de invitados no
/// controla nada.
///
/// Los dos tipos en la misma tabla porque son la respuesta a la misma pregunta.
/// `socioId` = socio del club, que no gasta cupo de nadie; `nombre` = invitado
/// externo, que cuenta contra los 4 del mes. Exactamente uno de los dos.
model AcompananteReserva {
  id        Int  @id @default(autoincrement())
  reservaId Int  @map("reserva_id")
  socioId   Int? @map("socio_id")

  /// Solo un nombre: el invitado no tiene ficha propia (pregunta abierta 13). Muere
  /// con la reserva y no se reutiliza.
  nombre String?

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  socio   Socio?  @relation(fields: [socioId], references: [id], onDelete: SetNull)

  @@index([reservaId])
  @@index([socioId])
  @@map("acompanante_reserva")
}
